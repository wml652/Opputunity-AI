# Copy to deploy/compose/compose.env (git-ignored) and fill in the secrets, then:
#   docker compose --env-file deploy/compose/compose.env up --build
# The same variables become Container Apps secrets / env vars on Azure.

# PostgreSQL (compose: pgvector/pgvector:pg16; Azure: Flexible Server with VECTOR allow-listed)
POSTGRES_USER=ootg_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=opportunity
APP_DB_USER=ootg_app
APP_DB_PASSWORD=change-me-app

# Generate: uv run python -m app.infrastructure.crypto.keygen   (format "1:<base64 32 bytes>")
ENCRYPTION_KEYS=
# >= 32 random characters
JWT_SECRET=

# Public origin of the console (cookies, CORS / WebSocket Origin check, notification links).
CONSOLE_URL=http://localhost:3000
# Browsers treat http://localhost as a secure context, so Secure cookies work locally too.
COOKIE_SECURE=true

# Global browser pool (Redis, across every container).
MAX_BROWSERS=3
MAX_HITL_BROWSERS=2
