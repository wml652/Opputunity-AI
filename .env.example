# Copy to backend/.env (the backend also reads ../.env). Never commit real values.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- PostgreSQL 16 + pgvector -------------------------------------------------------------
# App role MUST NOT be a superuser (superusers bypass row-level security).
# Neon/Supabase: paste the pooled connection string; postgres:// is rewritten to asyncpg.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/opportunity
# Optional owner role for Alembic migrations (defaults to DATABASE_URL).
# DATABASE_MIGRATION_URL=postgresql+asyncpg://owner:owner@localhost:5432/opportunity

# --- Redis (arq queues + SSE pub/sub) -----------------------------------------------------
# Upstash: rediss://default:<password>@<host>:6379   Windows native: Memurai on 6379
REDIS_URL=redis://localhost:6379/0

# --- Security -----------------------------------------------------------------------------
# 32+ random chars:  uv run python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes!!
# AES-256-GCM key ring "<version>:<base64 32 bytes>", comma separated; highest version encrypts.
# Generate:          uv run python -m app.infrastructure.crypto.keygen 1
ENCRYPTION_KEYS=
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM gateway --------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
# Allow custom base URLs on localhost/LAN (self-hosted vLLM/Ollama). Keep false in production.
LLM_ALLOW_PRIVATE_HOSTS=false
LLM_ALLOW_INSECURE_HTTP=false

# DEV ONLY: skip the login page; every request acts as dev@opportunity.local. Refused in production.
DEV_AUTH_BYPASS=false

# --- Events / workers ---------------------------------------------------------------------
# Dev convenience: run the outbox relay inside the API process (production: in `worker`).
OUTBOX_RELAY_IN_API=true

# --- Frontend (frontend/.env.local) -------------------------------------------------------
# BACKEND_URL=http://127.0.0.1:8000
